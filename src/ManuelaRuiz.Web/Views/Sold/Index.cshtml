    ViewData["Title"] = Lang.T("Sold homes and buyer representation | Manuela Ruiz", "Casas vendidas y compradores representados | Manuela Ruiz");
    ViewData["MetaDescription"] = Lang.T(
        "Documented buyer and seller representation across Charlotte and nearby cities. Browse recent transactions with Manuela Ruiz.",
        "Representación documentada de compradores y vendedores en Charlotte y ciudades cercanas. Revisa transacciones recientes con Manuela Ruiz.");
    ViewData["Breadcrumbs"] = new List<(string, string)>
    {
        (Lang.T("Home", "Inicio"), "/"),
        (Lang.T("Properties", "Propiedades"), "/sold")
    };
}
<div class="soldPage">
<section class="soldHero">
    <div>
        <p class="eyebrow">@Lang.T("Documented real estate portfolio", "Portafolio inmobiliario documentado")</p>
        <h1>@Lang.T("Homes bought. Homes sold. Work you can see.", "Casas compradas. Casas vendidas. Trabajo que puedes ver.")</h1>
        <p>@Lang.T("Explore documented transactions where Manuela participated as the buyer's or seller's agent, plus a confirmed active listing. Everything stays on Manuela's website.", "Explora operaciones documentadas donde Manuela participó como agente del comprador o del vendedor, además de un listado activo confirmado. Todo permanece dentro del website de Manuela.")</p>
        <div class="actions">
            <a class="btn primary" href="/search">@Lang.T("Search for a home", "Buscar una casa")</a>
            <a class="btn ghost" href="/qualify">@Lang.T("Estimate my range", "Estimar mi rango")</a>
        </div>
    </div>
    <aside>
        <strong>16</strong>
        <span>@Lang.T("closed transactions documented publicly", "operaciones cerradas documentadas públicamente")</span>
        <small>@Lang.T("Information gathered in August 2026. Buyer, seller and active listing are clearly separated.", "Información recopilada en agosto de 2026. Separa claramente comprador, vendedor y listado activo.")</small>
    </aside>
</section>
