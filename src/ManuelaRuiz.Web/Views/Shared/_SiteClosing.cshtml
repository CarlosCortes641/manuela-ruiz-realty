@{
    if (ViewData["HideClosing"] as bool? == true)
    {
        return;
    }

    var title = ViewData["ClosingTitle"] as string
        ?? Lang.T("A clear conversation can change the next step.", "Una conversación clara puede cambiar el próximo paso.");
    var body = ViewData["ClosingBody"] as string
        ?? Lang.T("Schedule a bilingual consultation with Manuela. No pressure and no unrealistic promises.", "Agenda una consulta bilingüe con Manuela. Sin presión y sin promesas irreales.");
    var primary = ViewData["ClosingPrimary"] as string
        ?? Lang.T("Get started", "Comenzar");
    var primaryHref = ViewData["ClosingPrimaryHref"] as string ?? "/#start";
    var secondary = ViewData["ClosingSecondary"] as string ?? SiteInfo.PhoneDisplay;
    var secondaryHref = ViewData["ClosingSecondaryHref"] as string ?? $"tel:{SiteInfo.PhoneTel}";
    var micro = ViewData["ClosingMicro"] as string
        ?? Lang.T("Charlotte · North Carolina · Español · English", "Charlotte · North Carolina · Español · English");
}
<section class="closing" aria-labelledby="closing-title">
    <div class="closingInner">
        <p class="closingMark" aria-hidden="true">MR</p>
        <h2 id="closing-title">@title</h2>
        @if (!string.IsNullOrWhiteSpace(body))
        {
            <p class="closingBody">@body</p>
        }
        <div class="closingActions">
            <a class="closingPrimary" href="@primaryHref">@primary <span aria-hidden="true">→</span></a>
            <a class="closingLink" href="@secondaryHref">@secondary <span aria-hidden="true">↗</span></a>
        </div>
        @if (!string.IsNullOrWhiteSpace(micro))
        {
            <small class="closingMicro">@micro</small>
        }
    </div>
</section>
