@{
    ViewData["Title"] = Lang.T("Relocate to Charlotte in Spanish or English | Manuela Ruiz", "Relocation a Charlotte en español o inglés | Manuela Ruiz");
    ViewData["MetaDescription"] = Lang.T(
        "Relocating to Charlotte? Bilingual support for neighborhoods, timeline, schools and the purchase process with Manuela Ruiz Realty.",
        "¿Te mudas a Charlotte? Apoyo bilingüe en barrios, plazos, escuelas y el proceso de compra con Manuela Ruiz Realty.");
    ViewData["Breadcrumbs"] = new List<(string, string)>
    {
        (Lang.T("Home", "Inicio"), "/"),
        ("Relocation", "/relocation")
    };
}
<div class="detailPage">
<section class="detailHero">
    <p class="eyebrow">@Lang.T("Relocation to Charlotte · Charlotte NC", "Relocation a Charlotte · Charlotte NC")</p>
    <h1>@Lang.T("Understand the market before you move your life.", "Conoce el mercado antes de mover la vida.")</h1>
    <p>@Lang.T("For families arriving from another state or country, Manuela organizes a remote strategy, tours, area comparisons and a local network. No website should decide schools, safety or commute for you: we verify sources and personal priorities.", "Para familias que llegan desde otro estado o país, Manuela organiza una estrategia remota, recorridos, comparaciones de zonas y una red local. Ningún sitio debe decidir escuelas, seguridad o commute por ti: verificamos fuentes y prioridades personales.")</p>
    <div class="actions">
        <a class="btn primary" href="#consult">@Lang.T("Prepare my consultation", "Preparar mi consulta")</a>
        <a class="btn ghost" href="tel:@SiteInfo.PhoneTel">@SiteInfo.PhoneDisplay</a>
    </div>
</section>
<section class="detailContext">
    <div>
        <p class="eyebrow">@Lang.T("How Manuela helps you", "Cómo te ayuda Manuela")</p>
        <h2>@Lang.T("Choosing a community is also part of buying", "Escoger comunidad también es parte de comprar")</h2>
        <p>@Lang.T("Manuela has supported a remote purchase from California for a couple moving to the Charlotte area. The process started by comparing communities, lifestyle and budget; then continued with virtual tours, local evaluation and coordination through arrival.", "Manuela ha acompañado una compra remota desde California para una pareja que se mudaba al área de Charlotte. El proceso comenzó comparando comunidades, estilo de vida y presupuesto; luego continuó con recorridos virtuales, evaluación local y coordinación hasta la llegada.")</p>
    </div>
    <ul>
        <li><span>✓</span>@Lang.T("Work, family, date and lifestyle", "Trabajo, familia, fecha y estilo de vida")</li>
        <li><span>✓</span>@Lang.T("Charlotte, suburbs and corridors", "Charlotte, suburbios y corredores")</li>
        <li><span>✓</span>@Lang.T("Virtual tours with local context", "Recorridos virtuales con contexto local")</li>
        <li><span>✓</span>@Lang.T("Inspection, insurance, title and delivery", "Inspección, seguro, título y entrega")</li>
    </ul>
</section>
<section class="detailSteps">
    <p class="eyebrow">@Lang.T("Step-by-step process", "Proceso paso a paso")</p>
    <h2>@Lang.T("What we do and why it matters.", "Qué hacemos y por qué importa.")</h2>
    <div>
        <article><span>01</span><h3>@Lang.T("Discovery call", "Llamada de descubrimiento")</h3><p>@Lang.T("Work, date, budget, lifestyle and priorities.", "Trabajo, fecha, presupuesto, estilo de vida y prioridades.")</p></article>
        <article><span>02</span><h3>@Lang.T("Personalized map", "Mapa personalizado")</h3><p>@Lang.T("Compare corridors, municipalities, commute times and home types.", "Compara corredores, municipios, tiempos y tipos de vivienda.")</p></article>
        <article><span>03</span><h3>@Lang.T("Remote financing", "Financiamiento remoto")</h3><p>@Lang.T("Prepare documents and understand costs before the trip.", "Prepara documentos y entiende costos antes del viaje.")</p></article>
        <article><span>04</span><h3>@Lang.T("Virtual or in-person tour", "Tour virtual o presencial")</h3><p>@Lang.T("Tours with video, street context and condition questions.", "Recorridos con video, contexto de calle y preguntas de condición.")</p></article>
        <article><span>05</span><h3>@Lang.T("Local due diligence", "Due diligence local")</h3><p>@Lang.T("Inspection, specialists, insurance, title and logistics.", "Inspección, especialistas, seguros, título y logística.")</p></article>
        <article><span>06</span><h3>@Lang.T("Arrival and providers", "Llegada y proveedores")</h3><p>@Lang.T("Closing, keys and connections for property services.", "Cierre, llaves y conexiones para servicios de propiedad.")</p></article>
    </div>
</section>
<section class="detailCheck">
    <div>
        <p class="eyebrow">@Lang.T("Get ready", "Prepárate")</p>
        <h2>@Lang.T("Bring these answers to the conversation.", "Trae estas respuestas a la conversación.")</h2>
    </div>
    <ul>
        <li>✓ @Lang.T("Work address or commute pattern", "Dirección del trabajo o patrón de commute")</li>
        <li>✓ @Lang.T("Move deadline", "Fecha límite de mudanza")</li>
        <li>✓ @Lang.T("Buy now or rent first", "Compra inmediata o renta primero")</li>
        <li>✓ @Lang.T("Property and community needs", "Necesidades de propiedad y comunidad")</li>
    </ul>
</section>
<section class="detailLinks">
    <p class="eyebrow">@Lang.T("Tools and next steps", "Herramientas y próximos pasos")</p>
    <a href="/search">@Lang.T("Search by ZIP, price, beds and baths →", "Buscar por ZIP, precio, habitaciones y baños →")</a>
    <a href="/qualify">@Lang.T("Estimate buying power →", "Estimar poder de compra →")</a>
    <a href="/areas">@Lang.T("Cities and market →", "Ciudades y mercado →")</a>
    <a href="/buyers">@Lang.T("Buyer guide →", "Guía de compradores →")</a>
</section>
<section class="detailFaq">
    <p class="eyebrow">FAQ</p>
    <h2>@Lang.T("Open, direct answers.", "Respuestas abiertas y directas.")</h2>
    <div class="faqOpen">
        <article><h3>@Lang.T("Do you cover about two hours around Charlotte?", "¿Cubren dos horas alrededor de Charlotte?")</h3><p>@Lang.T("Opportunities are evaluated roughly within that radius in North Carolina, subject to availability and practical representation.", "Se evalúan oportunidades aproximadamente dentro de ese radio en North Carolina, sujeto a disponibilidad y a que la representación sea práctica.")</p></article>
        <article><h3>@Lang.T("What about Rock Hill?", "¿Y Rock Hill?")</h3><p>@Lang.T("South Carolina inquiries are oriented or referred through professionals with the applicable license. SC representation is not assumed.", "Las consultas de South Carolina se orientan o refieren mediante profesionales con licencia aplicable. No se presume representación de SC.")</p></article>
    </div>
</section>
<section class="detailConsult" id="consult">
    <div>
        <p class="eyebrow">@Lang.T("Bilingual consultation", "Consulta bilingüe")</p>
        <h2>@Lang.T("Start with where you are and where you need to land.", "Comienza con dónde estás y dónde necesitas llegar.")</h2>
        <p>@Lang.T("The form identifies your situation so follow-up is specific. It is a real estate consultation, not a credit application.", "El formulario identifica tu situación para que el seguimiento sea específico. Es una consulta inmobiliaria, no una solicitud de crédito.")</p>
    </div>
    <form class="intake" method="post" action="/leads/intake">
        @Html.AntiForgeryToken()
        <input type="hidden" name="source" value="relocation" />
        <input type="hidden" name="goal" value="relocation" />
        <label>@Lang.T("Full name", "Nombre completo")<input required autocomplete="name" name="name" /></label>
        <div class="formGrid">
            <label>Email<input type="email" required autocomplete="email" name="email" /></label>
            <label>@Lang.T("Phone", "Teléfono")<input type="tel" required autocomplete="tel" name="phone" /></label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Language", "Idioma")
                <select name="language">
                    @if (Lang.IsSpanish) { <option selected>Español</option><option>English</option> }
                    else { <option>Español</option><option selected>English</option> }
                </select>
            </label>
            <label>@Lang.T("Timeline", "Plazo")
                <select name="timeline"><option>0–3 months</option><option>3–6 months</option><option>6–12 months</option><option>@Lang.T("Exploring", "Explorando")</option></select>
            </label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Financing document", "Documento financiero")
                <select name="financing"><option>Social Security</option><option>ITIN</option><option>@Lang.T("Not sure", "No sé")</option></select>
            </label>
            <label>@Lang.T("Budget", "Presupuesto")
                <select name="budget"><option>$150k–$250k</option><option>$250k–$350k</option><option>$350k–$500k</option><option>$500k–$750k</option><option>$750k+</option><option>@Lang.T("I need to calculate it", "Necesito calcularlo")</option></select>
            </label>
        </div>
        <label>@Lang.T("Target city or area", "Ciudad o zona objetivo")<input placeholder="Charlotte, Concord, Gastonia, Rock Hill…" name="area" /></label>
        <label>@Lang.T("Most important thing Manuela should know", "Lo más importante que Manuela debe saber")
            <textarea name="notes" rows="4" placeholder="@Lang.T("Where you're moving from, work, family, date or main concern…", "Desde dónde te mudas, trabajo, familia, fecha o preocupación principal…")"></textarea>
        </label>
        <label class="consent">
            <input required type="checkbox" name="consent" value="yes" />
            <span>@Lang.T("I authorize Manuela Ruiz to contact me. South Carolina inquiries are coordinated with a professional who holds the applicable license.", "Autorizo que Manuela Ruiz me contacte. Las consultas de South Carolina se coordinan con un profesional que tenga la licencia aplicable.")</span>
        </label>
        <button class="btn primary">@Lang.T("Send consultation", "Enviar consulta")</button>
    </form>
</section>
</div>
