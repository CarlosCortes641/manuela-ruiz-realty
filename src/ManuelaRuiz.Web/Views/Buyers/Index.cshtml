@{
    ViewData["Title"] = Lang.T("Buy a home in Charlotte | Bilingual guide | Manuela Ruiz", "Comprar casa en Charlotte | Guía bilingüe | Manuela Ruiz");
}
<div class="detailPage">
<section class="detailHero">
    <p class="eyebrow">@Lang.T("Buyer guide · Charlotte NC", "Guía para compradores · Charlotte NC")</p>
    <h1>@Lang.T("Buy a home with fewer surprises and more clarity.", "Comprar casa con menos sorpresas y más claridad.")</h1>
    <p>@Lang.T("Manuela organizes budget, search, offer, property research and closing in a bilingual process. If you are exploring ITIN, down-payment assistance or an employment letter, the conversation starts with documents and questions — not promises.", "Manuela organiza presupuesto, búsqueda, oferta, investigación de la propiedad y cierre en un proceso bilingüe. Si exploras ITIN, down-payment assistance o una carta de empleo, la conversación empieza por documentos y preguntas, no por promesas.")</p>
    <div class="actions">
        <a class="btn primary" href="#consult">@Lang.T("Prepare my consultation", "Preparar mi consulta")</a>
        <a class="btn ghost" href="tel:@SiteInfo.PhoneTel">@SiteInfo.PhoneDisplay</a>
    </div>
</section>
<section class="detailContext">
    <div>
        <p class="eyebrow">@Lang.T("How Manuela helps you", "Cómo te ayuda Manuela")</p>
        <h2>@Lang.T("More than opening doors", "Más que abrir puertas")</h2>
        <p>@Lang.T("Follow-up starts before you see a home and continues after an offer is accepted. Manuela organizes owners, dates, documents and questions so the buyer knows what is happening, why it matters and what comes next.", "El seguimiento comienza antes de ver una casa y continúa después de aceptar una oferta. Manuela organiza responsables, fechas, documentos y preguntas para que el comprador sepa qué está pasando, por qué importa y qué sigue.")</p>
    </div>
    <ul>
        <li><span>✓</span>@Lang.T("Search by price, location, spaces and condition", "Búsqueda por precio, ubicación, espacios y condición")</li>
        <li><span>✓</span>@Lang.T("Total payment, not only list price", "Pago total, no solamente precio publicado")</li>
        <li><span>✓</span>@Lang.T("Inspection and specialists when needed", "Inspección y especialistas cuando se necesitan")</li>
        <li><span>✓</span>@Lang.T("Due diligence, appraisal, title and closing calendar", "Calendario de due diligence, appraisal, título y cierre")</li>
    </ul>
</section>
<section class="detailSteps">
    <p class="eyebrow">@Lang.T("Step-by-step process", "Proceso paso a paso")</p>
    <h2>@Lang.T("What we do and why it matters.", "Qué hacemos y por qué importa.")</h2>
    <div>
        <article><span>01</span><h3>@Lang.T("Define your scenario", "Define tu escenario")</h3><p>@Lang.T("Goal, timeline, funds, income, financing document and areas.", "Meta, plazo, fondos, ingresos, documento de financiamiento y zonas.")</p></article>
        <article><span>02</span><h3>@Lang.T("Talk with a lender", "Habla con un prestamista")</h3><p>@Lang.T("Compare rate, APR, payment, reserves and costs. Only the lender approves.", "Compara tasa, APR, pago, reservas y costos. Solo el prestamista aprueba.")</p></article>
        <article><span>03</span><h3>@Lang.T("Search with criteria", "Busca con criterio")</h3><p>@Lang.T("Total price, commute, HOA, condition, resale and real priorities.", "Precio total, trayecto, HOA, condición, reventa y prioridades reales.")</p></article>
        <article><span>04</span><h3>@Lang.T("Offer and negotiation", "Oferta y negociación")</h3><p>@Lang.T("Price, dates, due diligence, contingencies and credits are reviewed together.", "Precio, fechas, due diligence, contingencias y créditos se revisan juntos.")</p></article>
        <article><span>05</span><h3>@Lang.T("Research the home", "Investiga la vivienda")</h3><p>@Lang.T("General inspection, appraisal, title and specialists when a finding warrants it.", "Inspección general, appraisal, título y especialistas cuando un hallazgo lo amerita.")</p></article>
        <article><span>06</span><h3>@Lang.T("Closing and delivery", "Cierre y entrega")</h3><p>@Lang.T("Final walkthrough, documents, funds, keys and property resources.", "Recorrido final, documentos, fondos, llaves y recursos para la propiedad.")</p></article>
    </div>
</section>
<section class="detailCheck">
    <div>
        <p class="eyebrow">@Lang.T("Get ready", "Prepárate")</p>
        <h2>@Lang.T("Bring these answers to the conversation.", "Trae estas respuestas a la conversación.")</h2>
    </div>
    <ul>
        <li>✓ @Lang.T("ID, income and available funds", "Identificación, ingresos y fondos disponibles")</li>
        <li>✓ @Lang.T("Comfortable monthly payment range", "Rango de pago mensual cómodo")</li>
        <li>✓ @Lang.T("Areas, commute and property type", "Zonas, trayecto y tipo de propiedad")</li>
        <li>✓ @Lang.T("Question list for lender and Realtor", "Lista de preguntas para lender y Realtor")</li>
    </ul>
</section>
<section class="detailLinks">
    <p class="eyebrow">@Lang.T("Tools and next steps", "Herramientas y próximos pasos")</p>
    <a href="/search">@Lang.T("Search by ZIP, price, beds and baths →", "Buscar por ZIP, precio, habitaciones y baños →")</a>
    <a href="/qualify">@Lang.T("Estimate buying power →", "Estimar poder de compra →")</a>
    <a href="/first-time-buyers">@Lang.T("First-time buyers →", "Primera vivienda →")</a>
    <a href="/new-construction">@Lang.T("New construction →", "Nueva construcción →")</a>
</section>
<section class="detailFaq">
    <p class="eyebrow">FAQ</p>
    <h2>@Lang.T("Open, direct answers.", "Respuestas abiertas y directas.")</h2>
    <div class="faqOpen">
        <article><h3>@Lang.T("Can I buy with an ITIN?", "¿Puedo comprar con ITIN?")</h3><p>@Lang.T("Some lenders offer products that consider ITIN. Down payment, rate, reserves and documents vary.", "Algunos prestamistas ofrecen productos que consideran ITIN. Pago inicial, tasa, reservas y documentos varían.")</p></article>
        <article><h3>@Lang.T("Do I need perfect credit?", "¿Necesito crédito perfecto?")</h3><p>@Lang.T("There is no single score for every option. A lender should evaluate your scenario.", "No existe un puntaje único para todas las opciones. Un prestamista debe evaluar tu escenario.")</p></article>
    </div>
</section>
<section class="detailConsult" id="consult">
    <div>
        <p class="eyebrow">@Lang.T("Bilingual consultation", "Consulta bilingüe")</p>
        <h2>@Lang.T("Tell Manuela where you are today.", "Cuéntale a Manuela dónde estás hoy.")</h2>
        <p>@Lang.T("The form identifies your situation so follow-up is specific. It is a real estate consultation, not a credit application.", "El formulario identifica tu situación para que el seguimiento sea específico. Es una consulta inmobiliaria, no una solicitud de crédito.")</p>
    </div>
    <form class="intake" method="post" action="/leads/intake">
        @Html.AntiForgeryToken()
        <input type="hidden" name="source" value="buyers" />
        <input type="hidden" name="goal" value="buy" />
        <label>@Lang.T("Full name", "Nombre completo")<input required autocomplete="name" name="name" /></label>
        <div class="formGrid">
            <label>Email<input type="email" required autocomplete="email" name="email" /></label>
            <label>@Lang.T("Phone", "Teléfono")<input type="tel" required autocomplete="tel" name="phone" /></label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Language", "Idioma")
                <select name="language">
                    @if (Lang.IsSpanish) { <option selected>Español</option><option>English</option> }
                    else { <option>Español</option><option selected>English</option> }
                </select>
            </label>
            <label>@Lang.T("Timeline", "Plazo")
                <select name="timeline"><option>0–3 months</option><option>3–6 months</option><option>6–12 months</option><option>@Lang.T("Exploring", "Explorando")</option></select>
            </label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Financing document", "Documento financiero")
                <select name="financing"><option>Social Security</option><option>ITIN</option><option>@Lang.T("Not sure", "No sé")</option></select>
            </label>
            <label>@Lang.T("Budget", "Presupuesto")
                <select name="budget"><option>$150k–$250k</option><option>$250k–$350k</option><option>$350k–$500k</option><option>$500k–$750k</option><option>$750k+</option><option>@Lang.T("I need to calculate it", "Necesito calcularlo")</option></select>
            </label>
        </div>
        <label>@Lang.T("Target city or area", "Ciudad o zona objetivo")<input placeholder="Charlotte, Concord, Gastonia, Rock Hill…" name="area" /></label>
        <label>@Lang.T("Most important thing Manuela should know", "Lo más importante que Manuela debe saber")
            <textarea name="notes" rows="4" placeholder="@Lang.T("Work, family, condition, spaces, date or main concern…", "Trabajo, familia, condición, espacios, fecha o preocupación principal…")"></textarea>
        </label>
        <label class="consent">
            <input required type="checkbox" name="consent" value="yes" />
            <span>@Lang.T("I authorize Manuela Ruiz to contact me. South Carolina inquiries are coordinated with a professional who holds the applicable license.", "Autorizo que Manuela Ruiz me contacte. Las consultas de South Carolina se coordinan con un profesional que tenga la licencia aplicable.")</span>
        </label>
        <button class="btn primary">@Lang.T("Send consultation", "Enviar consulta")</button>
    </form>
</section>
</div>
