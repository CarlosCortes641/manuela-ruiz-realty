@{
    ViewData["Title"] = Lang.T(
        "Manuela Ruiz | Bilingual Realtor in Charlotte NC",
        "Manuela Ruiz | Realtor bilingüe en Charlotte NC");
    var langValue = Lang.IsSpanish ? "Español" : "English";
}
<section class="zeroDownBanner" id="zero-down">
    <div class="zeroDownMark"><strong>0%</strong><span>DOWN<br/>PAYMENT</span></div>
    <div class="zeroDownCopy">
        <p class="eyebrow">@Lang.T("Buyer programs · Charlotte and North Carolina", "Programas para compradores · Charlotte y North Carolina")</p>
        <h2>@Lang.T("Can you buy with zero down or down-payment help?", "¿Puedes comprar con zero down o ayuda para el enganche?")</h2>
        <p>@Lang.T("Review USDA, VA, NACA, HouseCharlotte, NC Home Advantage and the $15,000 first-time buyer option. Manuela organizes the first step and a participating lender confirms eligibility.", "Revisa USDA, VA, NACA, HouseCharlotte, NC Home Advantage y la opción de $15,000 para first-time buyers. Manuela organiza el primer paso y un lender participante confirma elegibilidad.")</p>
        <small>@Lang.T("0% down payment does not always mean $0 to close. Inspection, appraisal, prepaid items, reserves and other costs may still apply.", "0% de down payment no siempre significa $0 para cerrar. Pueden existir inspección, appraisal, prepagados, reservas y otros costos.")</small>
    </div>
    <div class="zeroDownActions">
        <a class="btn zeroApply" href="/programs#program-contact">@Lang.T("Apply for a review", "Aplicar para una revisión")</a>
        <a class="zeroLearn" href="/programs">@Lang.T("Compare the 6 programs →", "Comparar los 6 programas →")</a>
        <span>@Lang.T("No credit pull · Not a loan application", "Sin credit pull · No es solicitud de préstamo")</span>
    </div>
</section>

<section class="heroV2" id="top">
    <div class="heroText">
        <p class="eyebrow">@Lang.T("Bilingual Realtor · Charlotte, North Carolina", "Realtor bilingüe · Charlotte, North Carolina")</p>
        <h1>@Lang.T("Don't just find a home. Understand every decision.", "No solo encuentres una casa. Entiende cada decisión.")</h1>
        <p class="lead">@Lang.T("Buy, sell, invest or move to North Carolina with Manuela Ruiz. Personalized search, financial preparation, inspections and guidance in Spanish or English from the first conversation through closing.", "Compra, vende, invierte o muévete a North Carolina con Manuela Ruiz. Búsqueda personalizada, preparación financiera, inspecciones y guía en español o inglés desde la primera conversación hasta el cierre.")</p>
        <div class="actions">
            <a class="btn primary" href="/search">@Lang.T("Search for the home I need", "Buscar la casa que necesito")</a>
            <a class="btn ghost" href="/qualify">@Lang.T("Estimate how much I can buy", "Estimar cuánto puedo comprar")</a>
        </div>
        <div class="trustRow">
            <span>✓ @Lang.T("First home", "Primera vivienda")</span>
            <span>✓ @Lang.T("ITIN conversations", "Conversaciones ITIN")</span>
            <span>✓ @Lang.T("New construction", "Nueva construcción")</span>
            <span>✓ @Lang.T("Relocation & investment", "Relocation & investment")</span>
        </div>
    </div>
    <div class="heroPhoto">
        <img src="/img/manuela-ruiz.jpg" alt="@Lang.T("Manuela Ruiz, bilingual Realtor in Charlotte, North Carolina", "Manuela Ruiz, Realtor bilingüe en Charlotte, North Carolina")" />
        <div>
            <small>Guerra &amp; Associates Realty LLC</small>
            <strong>Manuela Ruiz</strong>
            <span>NC Broker #@SiteInfo.License · Español · English</span>
        </div>
    </div>
</section>

<section class="homeSearch" data-home-search id="home-search">
    <div class="toolIntro">
        <p class="eyebrow">@Lang.T("Personalized search", "Búsqueda personalizada")</p>
        <h2>@Lang.T("Tell Manuela what home you're looking for.", "Dile a Manuela qué casa estás buscando.")</h2>
        <p>@Lang.T("Define the place, price range and must-have spaces. Manuela will review current inventory and prepare a search based on your priorities — we don't send you to another real estate portal.", "Define el lugar, rango de precio y espacios indispensables. Manuela revisará inventario actual y preparará una búsqueda basada en tus prioridades; no te enviamos a otro portal inmobiliario.")</p>
        <div class="searchSummary">
            <small>@Lang.T("Your search", "Tu búsqueda")</small>
            <strong>Charlotte, NC · $250,000–$450,000 · 3+ beds · 2+ baths</strong>
        </div>
    </div>
    <form class="searchForm" method="post" action="/leads/search">
        @Html.AntiForgeryToken()
        <label class="wide">@Lang.T("City, address or ZIP", "Ciudad, dirección o ZIP")
            <input name="location" required placeholder="Charlotte, 28205, Rock Hill…" value="Charlotte, NC" />
        </label>
        <div class="formGrid">
            <label>@Lang.T("Minimum price", "Precio mínimo")
                <div class="moneyInput"><span>$</span><input type="number" name="minPrice" min="0" step="5000" value="250000" /></div>
            </label>
            <label>@Lang.T("Maximum price", "Precio máximo")
                <div class="moneyInput"><span>$</span><input type="number" name="maxPrice" min="0" step="5000" value="450000" /></div>
            </label>
        </div>
        <div class="formGrid three">
            <label>@Lang.T("Beds", "Habitaciones")
                <select name="beds">
                    <option value="1">1+</option><option value="2">2+</option><option value="3" selected>3+</option><option value="4">4+</option><option value="5">5+</option>
                </select>
            </label>
            <label>@Lang.T("Baths", "Baños")
                <select name="baths">
                    <option value="1">1+</option><option value="1.5">1.5+</option><option value="2" selected>2+</option><option value="2.5">2.5+</option><option value="3">3+</option><option value="4">4+</option>
                </select>
            </label>
            <label>@Lang.T("Type", "Tipo")
                <select name="propertyType">
                    <option selected>House / Casa</option><option>Townhome</option><option>Condo</option><option>Land / Terreno</option><option>New construction</option><option>Investment property</option>
                </select>
            </label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Full name", "Nombre completo")<input required autocomplete="name" name="name" /></label>
            <label>Email<input required type="email" autocomplete="email" name="email" /></label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Phone", "Teléfono")<input required type="tel" autocomplete="tel" name="phone" /></label>
            <label>@Lang.T("When do you want to buy?", "¿Cuándo quieres comprar?")
                <select name="timeline">
                    <option>0–3 months</option><option>3–6 months</option><option>6–12 months</option>
                    <option>@Lang.T("Just exploring", "Solo explorando")</option>
                </select>
            </label>
        </div>
        <input type="hidden" name="language" value="@langValue" />
        <label class="consent">
            <input required type="checkbox" name="consent" value="yes" />
            <span>@Lang.T("I authorize Manuela Ruiz to contact me about this search. For Rock Hill or another South Carolina city, the inquiry will be coordinated with a professional who holds the applicable license.", "Autorizo que Manuela Ruiz me contacte sobre esta búsqueda. Para Rock Hill u otra ciudad de South Carolina, la consulta se coordinará con un profesional que tenga la licencia aplicable.")</span>
        </label>
        <button class="btn primary">@Lang.T("Send my search to Manuela", "Enviar mi búsqueda a Manuela")</button>
    </form>
</section>

<section class="start" id="start">
    <div class="startIntro">
        <p class="eyebrow">01 · @Lang.T("Start here", "Comienza aquí")</p>
        <h2>@Lang.T("What do you want to achieve?", "¿Qué quieres lograr?")</h2>
        <p>@Lang.T("The form changes with your goal and saves the inquiry for follow-up. It does not pull credit or constitute a loan application.", "El formulario cambia según tu meta y guarda la consulta para seguimiento. No revisa crédito ni constituye una solicitud de préstamo.")</p>
        <ul>
            <li>@Lang.T("No credit pull", "Sin revisión de crédito")</li>
            <li>@Lang.T("Bilingual response", "Respuesta bilingüe")</li>
            <li>@Lang.T("Questions tailored to your situation", "Preguntas adaptadas a tu situación")</li>
        </ul>
    </div>
    <form class="intake" method="post" action="/leads/intake">
        @Html.AntiForgeryToken()
        <fieldset>
            <legend>@Lang.T("What do you want to do?", "¿Qué quieres hacer?")</legend>
            <div class="segmented">
                <label><input type="radio" name="goal" checked value="buy" /><span>@Lang.T("Buy", "Comprar")</span></label>
                <label><input type="radio" name="goal" value="sell" /><span>@Lang.T("Sell", "Vender")</span></label>
                <label><input type="radio" name="goal" value="invest" /><span>@Lang.T("Invest", "Invertir")</span></label>
            </div>
        </fieldset>
        <label>@Lang.T("Full name", "Nombre completo")<input required autocomplete="name" name="name" /></label>
        <div class="formGrid">
            <label>Email<input required type="email" autocomplete="email" name="email" /></label>
            <label>@Lang.T("Phone", "Teléfono")<input required type="tel" autocomplete="tel" name="phone" /></label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Preferred language", "Idioma preferido")
                <select name="language">
                    @if (Lang.IsSpanish)
                    {
                        <option selected>Español</option><option>English</option>
                    }
                    else
                    {
                        <option>Español</option><option selected>English</option>
                    }
                </select>
            </label>
            <label>@Lang.T("When do you want to start?", "¿Cuándo quieres empezar?")
                <select name="timeline">
                    <option>@Lang.T("Now / 0–3 months", "Ahora / 0–3 meses")</option>
                    <option>3–6 months</option><option>6–12 months</option>
                    <option>@Lang.T("Just exploring", "Solo explorando")</option>
                </select>
            </label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Document for financing", "Documento para financiamiento")
                <select name="financing">
                    <option>Social Security</option><option>ITIN</option>
                    <option>@Lang.T("Not sure", "No estoy seguro/a")</option>
                </select>
            </label>
            <label>@Lang.T("Estimated credit", "Crédito estimado")
                <select name="credit">
                    <option>760+</option><option>740–759</option><option>700–739</option><option>660–699</option><option>620–659</option>
                    <option>@Lang.T("Not sure", "No sé / Not sure")</option>
                </select>
            </label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Years in job or business", "Años en empleo o negocio")
                <input inputmode="decimal" placeholder="@Lang.T("e.g. 2", "Ej. 2")" name="employmentYears" />
            </label>
            <label>@Lang.T("Approximate budget", "Presupuesto aproximado")
                <select name="budget">
                    <option>$200k–$300k</option><option>$300k–$450k</option><option>$450k–$650k</option><option>$650k+</option>
                    <option>@Lang.T("Not sure yet", "No sé todavía")</option>
                </select>
            </label>
        </div>
        <label>@Lang.T("Area of interest", "Zona de interés")
            <input placeholder="Charlotte, Concord, Matthews…" name="area" />
        </label>
        <label class="consent">
            <input required type="checkbox" name="consent" value="yes" />
            <span>@Lang.T("I authorize Manuela Ruiz to contact me about this inquiry. I am not applying for a loan.", "Autorizo que Manuela Ruiz me contacte sobre esta consulta. No estoy solicitando un préstamo.")</span>
        </label>
        <button class="btn primary">@Lang.T("Send my inquiry", "Enviar mi consulta")</button>
    </form>
</section>

<section class="serviceSection">
    <p class="eyebrow">02 · @Lang.T("Specialties", "Especialidades")</p>
    <h2>@Lang.T("Choose your situation. See the full process.", "Elige tu situación. Ve el proceso completo.")</h2>
    <div class="serviceGrid six">
        <article><span>01</span><h3>@Lang.T("Buyers", "Compradores")</h3><p>@Lang.T("First home, ITIN or traditional purchase: budget, search, offer, inspection and closing.", "Primera casa, ITIN o compra tradicional: presupuesto, búsqueda, oferta, inspección y cierre.")</p><a href="/buyers">@Lang.T("See step-by-step guide →", "Ver guía paso a paso →")</a></article>
        <article><span>02</span><h3>@Lang.T("Sellers", "Vendedores")</h3><p>@Lang.T("Preparation, pricing strategy, marketing, offer review and closing coordination.", "Preparación, estrategia de precio, mercadeo, revisión de ofertas y coordinación del cierre.")</p><a href="/sellers">@Lang.T("See step-by-step guide →", "Ver guía paso a paso →")</a></article>
        <article><span>03</span><h3>@Lang.T("Investors", "Inversionistas")</h3><p>@Lang.T("Rental potential, condition, repairs, numbers and exit before committing capital.", "Renta potencial, condición, reparaciones, números y salida antes de comprometer capital.")</p><a href="/investors">@Lang.T("See step-by-step guide →", "Ver guía paso a paso →")</a></article>
        <article><span>04</span><h3>Relocation</h3><p>@Lang.T("Areas, remote tours, logistics and local professionals when you move to Charlotte.", "Zonas, recorridos remotos, logística y profesionales locales al mudarte a Charlotte.")</p><a href="/relocation">@Lang.T("See step-by-step guide →", "Ver guía paso a paso →")</a></article>
        <article><span>05</span><h3>@Lang.T("First-time buyers", "Primera vivienda")</h3><p>@Lang.T("A clear plan for documents, available assistance and decisions without pressure.", "Un plan claro para documentación, asistencia disponible y decisiones sin presión.")</p><a href="/first-time-buyers">@Lang.T("See step-by-step guide →", "Ver guía paso a paso →")</a></article>
        <article><span>06</span><h3>@Lang.T("Purchase programs", "Programas de compra")</h3><p>@Lang.T("USDA, VA, NACA, HouseCharlotte and state options explained without promising approval.", "USDA, VA, NACA, HouseCharlotte y opciones estatales explicadas sin prometer aprobación.")</p><a href="/programs">@Lang.T("See step-by-step guide →", "Ver guía paso a paso →")</a></article>
        <article><span>07</span><h3>@Lang.T("New construction", "Nueva construcción")</h3><p>@Lang.T("Compare communities and builders, review incentives, contract, stages and inspections.", "Comparar comunidades y builders, revisar incentivos, contrato, etapas e inspecciones.")</p><a href="/new-construction">@Lang.T("See step-by-step guide →", "Ver guía paso a paso →")</a></article>
    </div>
</section>

<section class="calcV2" data-mortgage-calc data-loan-label="@Lang.T("estimated loan", "préstamo estimado")" data-assumed-label="@Lang.T("assumed", "supuesto")">
    <div class="calcCopy">
        <p class="eyebrow">03 · Mortgage calculator</p>
        <h2>@Lang.T("Change the numbers. The payment updates instantly.", "Cambia los números. El pago cambia al instante.")</h2>
        <p>@Lang.T("Try price, down payment, estimated credit, term and HOA. An educational tool to prepare questions.", "Prueba precio, pago inicial, crédito estimado, plazo y HOA. Es una herramienta educativa para preparar preguntas.")</p>
        <div class="calcTotal">
            <small>@Lang.T("Estimated monthly payment", "Pago mensual estimado")</small>
            <strong>$2,817<i>/mo</i></strong>
            <span>$337,500 @Lang.T("estimated loan", "préstamo estimado") · 6.65%</span>
        </div>
        <p class="fine">@Lang.T("Not a quote, approval or promise. The real rate depends on the lender, program, credit, income, property and date. It does not include every possible cost.", "No es cotización, aprobación ni promesa. La tasa real depende del prestamista, programa, crédito, ingresos, propiedad y fecha. No incluye todos los costos posibles.")</p>
    </div>
    <div class="calcControls">
        <label>@Lang.T("Home price", "Precio de la casa")
            <div class="moneyInput"><span>$</span><input type="number" min="50000" step="5000" value="375000" /></div>
            <input aria-label="@Lang.T("Home price slider", "Control de precio")" type="range" min="100000" max="1000000" step="5000" value="375000" />
        </label>
        <div class="formGrid">
            <label>@Lang.T("Down payment", "Pago inicial")
                <select><option value="3">3%</option><option value="5">5%</option><option value="10" selected>10%</option><option value="15">15%</option><option value="20">20%</option><option value="25">25%</option></select>
                <small>$37,500</small>
            </label>
            <label>@Lang.T("Estimated credit", "Crédito estimado")
                <select><option>760+</option><option>740–759</option><option selected>700–739</option><option>660–699</option><option>620–659</option><option>@Lang.T("Not sure", "No sé / Not sure")</option></select>
                <small>6.65% @Lang.T("assumed", "supuesto")</small>
            </label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Term", "Plazo")
                <select><option value="15">15 years</option><option value="20">20 years</option><option value="30" selected>30 years</option></select>
            </label>
            <label>HOA / month<input type="number" min="0" step="10" value="0" /></label>
        </div>
        <div class="breakdown">
            <span><b>@Lang.T("Principal + interest", "Principal + interés")</b>$2,167</span>
            <span><b>@Lang.T("Estimated taxes", "Impuestos estimados")</b>$313</span>
            <span><b>@Lang.T("Estimated insurance", "Seguro estimado")</b>$141</span>
            <span><b>@Lang.T("Estimated PMI", "PMI estimado")</b>$197</span>
            <span><b>HOA</b>$0</span>
        </div>
    </div>
</section>

<section class="qualifyTool" data-qualify-calc id="buying-power">
    <div class="qualifyInputs">
        <p class="eyebrow">@Lang.T("Educational buying-power estimator", "Estimador educativo de poder de compra")</p>
        <h2>@Lang.T("What home range could you discuss with a lender?", "¿Qué rango de casa podrías conversar con un lender?")</h2>
        <p>@Lang.T("Adjust the numbers. The calc combines income, debts, available funds, assumed rate and a total-debt scenario. It does not pull credit or approve loans.", "Ajusta los números. El cálculo combina ingresos, deudas, fondos disponibles, tasa supuesta y un escenario de deuda total. No revisa crédito ni aprueba préstamos.")</p>
        <div class="inputDeck">
            <div class="formGrid">
                <label>@Lang.T("Gross monthly household income", "Ingreso bruto mensual del hogar")
                    <div class="moneyInput"><span>$</span><input type="number" min="0" step="100" value="7000" /></div>
                </label>
                <label>@Lang.T("Monthly debts", "Deudas mensuales")
                    <div class="moneyInput"><span>$</span><input type="number" min="0" step="25" value="650" /></div>
                </label>
            </div>
            <div class="formGrid">
                <label>@Lang.T("Funds available to buy", "Fondos disponibles para comprar")
                    <div class="moneyInput"><span>$</span><input type="number" min="0" step="500" value="25000" /></div>
                </label>
                <label>@Lang.T("Assumed down payment", "Pago inicial supuesto")
                    <select><option value="3">3%</option><option value="3.5">3.5%</option><option value="5" selected>5%</option><option value="10">10%</option><option value="20">20%</option></select>
                </label>
            </div>
            <div class="formGrid">
                <label>@Lang.T("Assumed rate", "Tasa supuesta")
                    <div class="suffixInput"><input type="number" min="1" max="15" step=".05" value="6.5" /><span>%</span></div>
                </label>
                <label>@Lang.T("Total debt scenario", "Escenario de deuda total")
                    <select>
                        <option value="36" selected>36% — @Lang.T("conservative", "conservador")</option>
                        <option value="43">43% — @Lang.T("to discuss", "para conversar")</option>
                        <option value="45">45% — @Lang.T("extra review", "revisión adicional")</option>
                    </select>
                </label>
            </div>
            <div class="formGrid">
                <label>@Lang.T("Current job/business history", "Historial actual de trabajo/negocio")
                    <select><option selected>2+ years</option><option>1–2 years</option><option>New job / Nuevo empleo</option><option>Self-employed / Negocio propio</option></select>
                </label>
                <label>@Lang.T("Document to explore", "Documento para explorar")
                    <select><option selected>Social Security</option><option>ITIN</option><option>@Lang.T("Not sure", "No estoy seguro/a")</option></select>
                </label>
            </div>
            <label>HOA / @Lang.T("month", "mes")
                <div class="moneyInput"><span>$</span><input type="number" min="0" step="10" value="0" /></div>
            </label>
        </div>
    </div>
    <div class="qualifyResult" aria-live="polite">
        <p class="eyebrow">@Lang.T("Estimated starting range", "Rango inicial estimado")</p>
        <strong>$204,595 – $240,700</strong>
        <span>@Lang.T("Illustrative home price", "Precio ilustrativo de vivienda")</span>
        <div class="resultFacts">
            <p><b>$1,870</b>@Lang.T("Max monthly housing within scenario", "Vivienda mensual máxima dentro del escenario")</p>
            <p><b>$12,035</b>@Lang.T("Approximate down payment at the max", "Pago inicial aproximado al máximo")</p>
            <p><b>$7,221</b>@Lang.T("Illustrative closing reserve (3%)", "Reserva ilustrativa para cierre (3%)")</p>
        </div>
        <div class="limitNote income">
            <b>@Lang.T("Today the income/debt ratio limits more.", "Hoy limita más la relación ingreso/deuda.")</b>
            <p>@Lang.T("That shows which question to take to the lender first. Programs, credit, reserves, taxes, insurance, HOA and documents can change the result.", "Eso indica qué pregunta llevar primero al lender. Programas, crédito, reservas, impuestos, seguro, HOA y documentación pueden cambiar el resultado.")</p>
        </div>
        <details>
            <summary>@Lang.T("How is it calculated?", "¿Cómo se calcula?")</summary>
            <p>@Lang.T("Uses a 36% total DTI scenario, subtracts debts and HOA, estimates principal/interest over 30 years, 1.0% taxes, 0.45% insurance, possible PMI and a 3% closing reserve. Editable assumptions — not lender terms.", "Usa un escenario de DTI total de 36%, resta deudas y HOA, estima principal/interés a 30 años, impuestos de 1.0%, seguro de 0.45%, posible PMI y reserva de cierre de 3%. Son supuestos editables, no términos de un lender.")</p>
        </details>
        <p class="privacyNote">@Lang.T("Privacy: your income, debts and funds are calculated only in your browser and are not sent or stored.", "Privacidad: tus ingresos, deudas y fondos se calculan solamente en tu navegador y no se envían ni guardan.")</p>
        <form class="resultLead" method="post" action="/leads/qualify">
            @Html.AntiForgeryToken()
            <input type="hidden" name="rangeLow" data-range-low />
            <input type="hidden" name="rangeHigh" data-range-high />
            <h3>@Lang.T("Send only my range to Manuela", "Enviar solamente mi rango a Manuela")</h3>
            <div class="formGrid">
                <label>@Lang.T("Name", "Nombre")<input required name="name" /></label>
                <label>Email<input required type="email" name="email" /></label>
            </div>
            <div class="formGrid">
                <label>@Lang.T("Phone", "Teléfono")<input required type="tel" name="phone" /></label>
                <label>@Lang.T("Area", "Zona")<input placeholder="Charlotte, Concord, Rock Hill…" name="area" /></label>
            </div>
            <div class="formGrid">
                <label>@Lang.T("Estimated credit", "Crédito estimado")
                    <select name="credit"><option>760+</option><option>700–759</option><option>660–699</option><option>620–659</option><option>&lt;620</option><option>@Lang.T("Not sure", "No sé")</option></select>
                </label>
                <label>@Lang.T("Timeline", "Plazo")
                    <select name="timeline"><option>0–3 months</option><option>3–6 months</option><option>6–12 months</option><option>@Lang.T("Getting ready", "Preparándome")</option></select>
                </label>
            </div>
            <input type="hidden" name="language" value="@langValue" />
            <label class="consent">
                <input required type="checkbox" name="consent" value="yes" />
                <span>@Lang.T("I authorize Manuela to contact me. I understand this is not a mortgage application or pre-approval.", "Autorizo que Manuela me contacte. Entiendo que esto no es una solicitud ni una preaprobación hipotecaria.")</span>
