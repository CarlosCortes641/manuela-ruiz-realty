@{
    ViewData["Title"] = Lang.T("Homebuying programs in Charlotte and North Carolina | Manuela Ruiz", "Programas para comprar casa en Charlotte y North Carolina | Manuela Ruiz");
}
<div class="programsPage">
<section class="programHero">
    <p class="eyebrow">@Lang.T("Charlotte · North Carolina · Bilingual guide", "Charlotte · North Carolina · Guía bilingüe")</p>
    <h1>@Lang.T("Programs that can change how much you need to buy.", "Programas que pueden cambiar cuánto necesitas para comprar.")</h1>
    <p>@Lang.T("Manuela helps her buyers identify, compare and organize questions about these paths. She represents the purchase; the participating lender and the program administrator verify documents, funds, eligibility and approval.", "Manuela ayuda a sus compradores a identificar, comparar y organizar preguntas sobre estas rutas. Ella representa la compra; el lender participante y el administrador del programa verifican documentos, fondos, elegibilidad y aprobación.")</p>
    <div class="actions">
        <a class="btn primary" href="#compare">@Lang.T("Compare programs", "Comparar programas")</a>
        <a class="btn ghost" href="#program-contact">@Lang.T("Request guidance", "Pedir orientación")</a>
    </div>
</section>
<section class="zeroExplain">
    <div>
        <p class="eyebrow">@Lang.T("01 · The important difference", "01 · La diferencia importante")</p>
        <h2>@Lang.T("0% down does not always mean $0 to close.", "0% de enganche no siempre significa $0 para cerrar.")</h2>
    </div>
    <div class="zeroCards">
        <article>
            <strong>0%</strong>
            <h3>Down payment</h3>
            <p>@Lang.T("The loan or assistance may cover the required down payment.", "El préstamo o la asistencia pueden cubrir el enganche requerido.")</p>
        </article>
        <article>
            <strong>$0?</strong>
            <h3>Cash to close</h3>
            <p>@Lang.T("Inspection, appraisal, due diligence, prepaid items, reserves and other costs may still apply.", "Todavía pueden existir inspección, appraisal, due diligence, prepagados, reservas y otros costos.")</p>
        </article>
    </div>
</section>
<section class="programCompare" id="compare">
    <p class="eyebrow">@Lang.T("02 · Six paths to review", "02 · Seis caminos para revisar")</p>
    <h2>@Lang.T("First identify the program. Then confirm every condition.", "Primero identifica el programa. Después confirma cada condición.")</h2>
    <div class="programCards">
        <article>
            <span>01</span>
            <small>@Lang.T("0% down possible", "0% de enganche posible")</small>
            <h3>USDA Guaranteed Loan</h3>
            <p>@Lang.T("USDA allows approved lenders to finance up to 100% for eligible buyers. The address and income are reviewed separately.", "USDA permite a lenders aprobados financiar hasta el 100% para compradores elegibles. La dirección y el ingreso se revisan por separado.")</p>
            <div>
                <b>@Lang.T("May fit if", "Puede encajar si")</b>
                <p>@Lang.T("Primary residence at an eligible rural address and household within the applicable income limit.", "Residencia principal en una dirección rural elegible y hogar dentro del límite de ingresos aplicable.")</p>
            </div>
            <div>
                <b>@Lang.T("Confirm", "Confirma")</b>
                <p>@Lang.T("USDA address, household income, property and approved lender.", "Dirección USDA, ingreso del hogar, propiedad y lender aprobado.")</p>
            </div>
            <a href="https://www.rd.usda.gov/programs-services/services" target="_blank" rel="noreferrer">@Lang.T("Review official source →", "Revisar fuente oficial →")</a>
        </article>
        <article>
            <span>02</span>
            <small>@Lang.T("VA does not require a down payment", "VA no exige enganche")</small>
            <h3>VA Home Loan</h3>
            <p>@Lang.T("VA does not require a down payment and does not require PMI; a lender may still require a down payment in some scenarios and a funding fee may apply.", "VA no exige down payment y no requiere PMI; un lender todavía puede exigir enganche en algunos escenarios y puede existir funding fee.")</p>
            <div>
                <b>@Lang.T("May fit if", "Puede encajar si")</b>
                <p>@Lang.T("Veterans, eligible service members and certain surviving spouses.", "Veteranos, miembros elegibles de las Fuerzas Armadas y ciertos cónyuges sobrevivientes.")</p>
            </div>
            <div>
                <b>@Lang.T("Confirm", "Confirma")</b>
                <p>@Lang.T("Certificate of eligibility, entitlement, appraisal, lender and funding fee.", "Certificado de elegibilidad, entitlement, appraisal, lender y funding fee.")</p>
            </div>
            <a href="https://www.benefits.va.gov/homeloans/index.asp" target="_blank" rel="noreferrer">@Lang.T("Review official source →", "Revisar fuente oficial →")</a>
        </article>
        <article>
            <span>03</span>
            <small>@Lang.T("No down payment, costs or PMI", "Sin enganche, costos o PMI")</small>
            <h3>NACA Purchase Program</h3>
            <p>@Lang.T("NACA advertises a mortgage with no down payment, closing costs, fees or mortgage insurance. Funds may still be needed for inspection, prepaid items and reserves.", "NACA anuncia una hipoteca sin down payment, closing costs, fees o mortgage insurance. Aun así, puede requerir fondos para inspección, prepagados y reservas.")</p>
            <div>
                <b>@Lang.T("May fit if", "Puede encajar si")</b>
                <p>@Lang.T("Buyers willing to complete financial counseling and NACA's documented process.", "Compradores dispuestos a completar counseling financiero y el proceso documentado de NACA.")</p>
            </div>
            <div>
                <b>@Lang.T("Confirm", "Confirma")</b>
                <p>@Lang.T("Workshop, membership, occupancy, documents, payment history and minimum funds.", "Workshop, membresía, ocupación, documentos, payment history y fondos mínimos.")</p>
            </div>
            <a href="https://www.naca.com/purchase-product/" target="_blank" rel="noreferrer">@Lang.T("Review official source →", "Revisar fuente oficial →")</a>
        </article>
        <article>
            <span>04</span>
            <small>@Lang.T("Up to $80,000 in certain cases", "Hasta $80,000 en ciertos casos")</small>
            <h3>HouseCharlotte</h3>
            <p>@Lang.T("The City publishes deferred and forgivable options for down payment, closing costs and interest-rate buy-down. The maximum depends on the category and eligible assistance that may match.", "La Ciudad publica opciones diferidas y perdonables para down payment, closing costs e interest-rate buy-down. El máximo depende de la categoría y de asistencia elegible que pueda hacer match.")</p>
            <div>
                <b>@Lang.T("May fit if", "Puede encajar si")</b>
                <p>@Lang.T("First-time buyers purchasing inside Charlotte who meet income, price, education and occupancy requirements.", "First-time buyers que compran dentro de Charlotte y cumplen requisitos de ingreso, precio, educación y ocupación.")</p>
            </div>
            <div>
                <b>@Lang.T("Confirm", "Confirma")</b>
                <p>@Lang.T("City limits, published maximum price of $365,000, AMI by household, funds and education.", "Límites de ciudad, precio máximo publicado de $365,000, AMI por hogar, fondos y educación.")</p>
            </div>
            <a href="https://www.charlottenc.gov/Streets-and-Neighborhoods/Housing/Resources-for-Homeowners-Renters/Homeownership" target="_blank" rel="noreferrer">@Lang.T("Review official source →", "Revisar fuente oficial →")</a>
        </article>
        <article>
            <span>05</span>
            <small>@Lang.T("Up to 3% assistance", "Hasta 3% de asistencia")</small>
            <h3>NC Home Advantage Mortgage™</h3>
            <p>@Lang.T("NCHFA publishes assistance of up to 3% of the loan. It currently indicates a maximum annual income of $158,000 and a credit score of 640+ for general eligibility.", "NCHFA publica asistencia de hasta 3% del préstamo. Actualmente indica ingreso anual máximo de $158,000 y credit score de 640+ para elegibilidad general.")</p>
            <div>
                <b>@Lang.T("May fit if", "Puede encajar si")</b>
                <p>@Lang.T("First-time or repeat buyers purchasing a primary residence in North Carolina through a participating lender.", "First-time o repeat buyers que compran residencia principal en North Carolina mediante un lender participante.")</p>
            </div>
            <div>
                <b>@Lang.T("Confirm", "Confirma")</b>
                <p>@Lang.T("Income, credit, loan type, price, occupancy within 60 days and participating lender.", "Ingreso, crédito, tipo de préstamo, precio, ocupación en 60 días y lender participante.")</p>
            </div>
            <a href="https://www.nchfa.com/home-buyers/buy-home/nc-home-advantage-mortgage" target="_blank" rel="noreferrer">@Lang.T("Review official source →", "Revisar fuente oficial →")</a>
        </article>
        <article>
            <span>06</span>
            <small>@Lang.T("$15,000 assistance", "$15,000 de asistencia")</small>
            <h3>NC 1st Home Advantage</h3>
            <p>@Lang.T("It is a deferred 0% second mortgage, forgiven 20% per year at the end of years 11–15. Selling, refinancing or transferring earlier may trigger repayment.", "Es una segunda hipoteca diferida al 0%, perdonada 20% por año al final de los años 11–15. Vender, refinanciar o transferir antes puede activar repago.")</p>
            <div>
                <b>@Lang.T("May fit if", "Puede encajar si")</b>
                <p>@Lang.T("First-time buyers, certain veterans or buyers in targeted census tracts who meet additional requirements.", "First-time buyers, ciertos veteranos o compradores en targeted census tracts que cumplen requisitos adicionales.")</p>
            </div>
            <div>
                <b>@Lang.T("Confirm", "Confirma")</b>
                <p>@Lang.T("First-time buyer definition, income, price, 640+ credit, occupancy and participating lender.", "Definición de first-time buyer, ingreso, precio, 640+ de crédito, ocupación y lender participante.")</p>
            </div>
            <a href="https://www.nchfa.com/home-buyers/home-buyer-mortgage-products/nc-1st-home-advantage-down-payment" target="_blank" rel="noreferrer">@Lang.T("Review official source →", "Revisar fuente oficial →")</a>
        </article>
    </div>
</section>
<section class="programExample">
    <p class="eyebrow">@Lang.T("03 · Educational example", "03 · Ejemplo educativo")</p>
    <div>
        <h2>@Lang.T("A $350,000 home with 3% equals $10,500 down.", "Una casa de $350,000 con 3% equivale a $10,500 de enganche.")</h2>
        <p>@Lang.T("Assistance of up to 3% could reduce much of that requirement if the buyer, loan and property qualify. HouseCharlotte or other compatible help could also change closing costs, but the exact combination must be approved by the lender and each program.", "Una asistencia de hasta 3% podría reducir gran parte de ese requisito si el comprador, préstamo y propiedad califican. HouseCharlotte u otra ayuda compatible podría cambiar también los closing costs, pero la combinación exacta debe aprobarla el lender y cada programa.")</p>
        <a class="btn primary" href="/qualify">@Lang.T("Estimate my starting point", "Estimar mi punto de partida")</a>
    </div>
    <aside>
        <strong>@Lang.T("Important for ITIN buyers", "Importante para compradores con ITIN")</strong>
        <p>@Lang.T("ITIN products are a separate conversation. Not every government or state program accepts the same documentation or can be combined. Manuela can organize the questions; the lender confirms the option.", "Los productos ITIN son una conversación separada. No todos los programas gubernamentales o estatales aceptan la misma documentación ni se pueden combinar. Manuela puede organizar las preguntas; el lender confirma la opción.")</p>
    </aside>
</section>
<section class="programIntake" id="program-contact">
    <div>
        <p class="eyebrow">@Lang.T("04 · Review with Manuela", "04 · Revisión con Manuela")</p>
        <h2>@Lang.T("Tell us which option you want to investigate.", "Dinos qué opción quieres investigar.")</h2>
        <p>@Lang.T("This form does not apply for a loan or guarantee assistance. It helps Manuela prepare a real estate conversation and connect you with the appropriate professional.", "Este formulario no solicita un préstamo ni garantiza asistencia. Ayuda a Manuela a preparar una conversación inmobiliaria y conectarte con el profesional apropiado.")</p>
    </div>
    <form class="intake" method="post" action="/leads/program">
        @Html.AntiForgeryToken()
        <div class="formGrid">
            <label>@Lang.T("Name", "Nombre")<input required name="name" autocomplete="name" /></label>
            <label>Email<input required type="email" name="email" autocomplete="email" /></label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Phone", "Teléfono")<input required type="tel" name="phone" autocomplete="tel" /></label>
            <label>@Lang.T("Area", "Zona")<input placeholder="Charlotte, Concord, Gastonia…" name="area" /></label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Language", "Idioma")
                <select name="language">
                    @if (Lang.IsSpanish) { <option selected>Español</option><option>English</option> }
                    else { <option>Español</option><option selected>English</option> }
                </select>
            </label>
            <label>@Lang.T("When do you want to buy?", "¿Cuándo quieres comprar?")
                <select name="timeline"><option>0–3 months</option><option>3–6 months</option><option>6–12 months</option><option>@Lang.T("Getting ready", "Preparándome")</option></select>
            </label>
        </div>
        <fieldset>
            <legend>@Lang.T("Programs you want to review", "Programas que quieres revisar")</legend>
            <div class="programChoices">
                <label><input type="checkbox" name="program" value="USDA Guaranteed Loan" /><span>USDA Guaranteed Loan</span></label>
                <label><input type="checkbox" name="program" value="VA Home Loan" /><span>VA Home Loan</span></label>
                <label><input type="checkbox" name="program" value="NACA Purchase Program" /><span>NACA Purchase Program</span></label>
                <label><input type="checkbox" name="program" value="HouseCharlotte" /><span>HouseCharlotte</span></label>
                <label><input type="checkbox" name="program" value="NC Home Advantage Mortgage™" /><span>NC Home Advantage Mortgage™</span></label>
                <label><input type="checkbox" name="program" value="NC 1st Home Advantage" /><span>NC 1st Home Advantage</span></label>
            </div>
        </fieldset>
        <div class="formGrid">
            <label>@Lang.T("Household size", "Tamaño del hogar")
                <select name="household"><option>1</option><option>2</option><option>3</option><option>4</option><option>5+</option></select>
            </label>
            <label>@Lang.T("First-time home", "Primera vivienda")
                <select name="firstTime"><option>@Lang.T("Yes", "Sí")</option><option>@Lang.T("No", "No")</option><option>@Lang.T("Not sure", "No estoy seguro/a")</option></select>
            </label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Veteran or eligible service", "Veterano o servicio elegible")
                <select name="veteran"><option>@Lang.T("No", "No")</option><option>@Lang.T("Yes", "Sí")</option><option>@Lang.T("Not sure", "No estoy seguro/a")</option></select>
            </label>
            <label>@Lang.T("Document to explore", "Documento para explorar")
                <select name="financing"><option>Social Security</option><option>ITIN</option><option>@Lang.T("Not sure", "No estoy seguro/a")</option></select>
            </label>
        </div>
        <div class="formGrid">
            <label>@Lang.T("Estimated credit", "Crédito estimado")
                <select name="credit"><option>760+</option><option>700–759</option><option>660–699</option><option>640–659</option><option>&lt;640</option><option>@Lang.T("Not sure", "No sé")</option></select>
            </label>
            <label>@Lang.T("Approximate price", "Precio aproximado")
                <select name="budget"><option>$200k–$300k</option><option>$300k–$365k</option><option>$365k–$450k</option><option>$450k–$525k</option><option>$525k+</option><option>@Lang.T("Not sure", "No sé")</option></select>
            </label>
        </div>
        <label>@Lang.T("Anything else Manuela should know", "Algo más que Manuela deba saber")
            <textarea name="notes" rows="3" placeholder="@Lang.T("Questions about eligibility, timeline or combining programs…", "Preguntas sobre elegibilidad, plazo o combinar programas…")"></textarea>
        </label>
        <label class="consent">
            <input required type="checkbox" name="consent" value="yes" />
            <span>@Lang.T("I authorize Manuela Ruiz to contact me about this inquiry. I understand this is not an application, pre-approval or promise of assistance.", "Autorizo que Manuela Ruiz me contacte sobre esta consulta. Entiendo que no es una solicitud, preaprobación ni promesa de asistencia.")</span>
        </label>
        <button class="btn primary">@Lang.T("Review my options", "Revisar mis opciones")</button>
    </form>
</section>
<section class="programSources">
    <h2>@Lang.T("Sources and limits", "Fuentes y límites")</h2>
    <p>@Lang.T("Information reviewed August 16, 2026. Amounts, rates, maps, allotments and rules can change. Always open the official source and confirm with the administrator and a participating lender before making an offer or moving money.", "Información revisada el 16 de agosto de 2026. Montos, tasas, mapas, cupos y reglas pueden cambiar. Siempre abre la fuente oficial y confirma con el administrador y un lender participante antes de hacer una oferta o mover dinero.")</p>
</section>
</div>
